# Vouch Beacon Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername
WEBHOOK_URL=https://your-replit-url.repl.co
ADMIN_ID=your_telegram_user_id

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Security
JWT_SECRET=your-very-secure-random-string-here-change-this

# Optional: Content Moderation
ENABLE_CONTENT_MODERATION=true
GROQ_API_KEY=your_groq_api_key_if_you_want_ai_moderation
MODERATION_LOG_CHANNEL=optional_telegram_channel_id_for_logs

# Server Configuration
PORT=5000
REPLIT_ENVIRONMENT=production
